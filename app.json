{
  "expo": {
    "name": "Creel Stray-Dog Reporting",
    "slug": "dog-report-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que Creel Stray-Dog Reporting use la cámara para fotografiar el reporte.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Creel Stray-Dog Reporting use tu ubicación para guardar dónde ocurrió el reporte."
        }
      ]
    ]
  }
}
